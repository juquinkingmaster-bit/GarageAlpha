# Variables à définir dans Vercel (Settings > Environment Variables). Ne jamais les mettre dans le code du site.
MONGODB_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=garage_alpha
SESSION_SECRET=         # chaîne aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SALT=             # généré par: node scripts/hash-password.js "Identifiant" "MotDePasse"
ADMIN_HASHES=           # idem (plusieurs empreintes possibles, séparées par des virgules)

# Après le premier changement de mot de passe dans le site, les identifiants sont stockés (hachés) dans MongoDB :
# ADMIN_SALT / ADMIN_HASHES ne servent plus qu'au tout premier accès.
